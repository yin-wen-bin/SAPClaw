  {
    "id": "MM-XAPI-001",
    "api": "MM",
    "scenario": "supplier_purchase_orders",
    "user_input": "查询供应商17300003的采购订单",
    "expected_api": "API_BUSINESS_PARTNER",
    "expected_apis": [
      "API_BUSINESS_PARTNER",
      "API_PURCHASEORDER_PROCESS_SRV"
    ],
    "expected_capability": {
      "route": true,
      "plan": true,
      "execute": true,
      "present": true,
      "clarify": false,
      "unsupported": false
    },
    "baseline": {
      "steps": [
        {
          "id": "supplier",
          "url": "/sap/opu/odata/sap/API_BUSINESS_PARTNER/A_Supplier?$select=Supplier,SupplierName&$filter=Supplier eq '17300003'&$top=5",
          "key_fields": [
            "Supplier"
          ]
        },
        {
          "id": "orders",
          "url": "/sap/opu/odata/sap/API_PURCHASEORDER_PROCESS_SRV/A_PurchaseOrder?$select=PurchaseOrder,Supplier,CompanyCode,PurchasingOrganization&$top=50",
          "key_fields": [
            "PurchaseOrder"
          ],
          "bind": {
            "source_step": "supplier",
            "source_field": "Supplier",
            "target_field": "Supplier"
          }
        }
      ]
    },
    "comparison": {
      "type": "key_subset",
      "keys": [
        "PurchaseOrder"
      ],
      "required_fields": [
        "PurchaseOrder",
        "Supplier"
      ]
    }
  },
