[
  {
    "id": "CO-XAPI-001",
    "api": "CO",
    "scenario": "company_cost_centers",
    "user_input": "查询公司1710下有哪些成本中心",
    "expected_api": "API_COMPANYCODE_SRV",
    "expected_apis": [
      "API_COMPANYCODE_SRV",
      "API_COSTCENTER_SRV"
    ],
    "expected_capability": {
      "route": true,
      "plan": true,
      "execute": true,
      "present": true,
      "clarify": false,
      "unsupported": false
    },
    "baseline": {
      "steps": [
        {
          "id": "company",
          "url": "/sap/opu/odata/sap/API_COMPANYCODE_SRV/A_CompanyCode?$select=CompanyCode,Company,ChartOfAccounts&$filter=CompanyCode eq '1710'&$top=5",
          "key_fields": [
            "CompanyCode"
          ]
        },
        {
          "id": "cost_centers",
          "url": "/sap/opu/odata/sap/API_COSTCENTER_SRV/A_CostCenter?$select=ControllingArea,CostCenter,CompanyCode,ProfitCenter&$top=50",
          "key_fields": [
            "ControllingArea",
            "CostCenter"
          ],
          "bind": {
            "source_step": "company",
            "source_field": "CompanyCode",
            "target_field": "CompanyCode"
          }
        }
      ]
    },
    "comparison": {
      "type": "key_subset",
      "keys": [
        "ControllingArea",
        "CostCenter"
      ],
      "required_fields": [
        "CostCenter",
        "CompanyCode"
      ]
    }
  },
