# SAP connection
SAP_ODATA_BASE_URL=https://<your-sap-host>
SAP_USERNAME=<your-sap-username>
SAP_PASSWORD=<your-sap-password>
SAP_CLIENT=<sap-client>
SAP_VERIFY_SSL=true
SAP_AUTH_TYPE=basic
SAP_ODATA_TIMEOUT_MS=30000

# Runtime paths
CASE_STORE_PATH=data/cases/cases.jsonl
LOCAL_INDEX_ROOT=data/index
API_SKILL_ROOT=data/api_skills
LOCAL_KG_ENABLED=true
LOCAL_KG_ROOT=data/knowledge_graph
LOCAL_KG_MAX_EVIDENCE=5
LLM_PROFILES_PATH=env/llm_profiles.json

# Default LLM profile
LLM_PROVIDER=<provider-name>
MINIMAX_BASE_URL=https://<your-llm-provider-base-url>
MINIMAX_MODEL=<model-name>
MINIMAX_API_KEY=<your-llm-api-key>
LLM_TIMEOUT_MS=45000
LLM_VERIFY_SSL=true

# Optional Kimi profile
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding
KIMI_API_KEY=<your-kimi-api-key>

# Optional providers
DEEPSEEK_BASE_URL=https://<your-deepseek-compatible-base-url>
DEEPSEEK_MODEL=<model-name>
DEEPSEEK_API_KEY=<your-deepseek-api-key>
GLM_BASE_URL=https://<your-glm-compatible-base-url>
GLM_MODEL=<model-name>
GLM_API_KEY=<your-glm-api-key>

# Internal query API.
# Required for external/shared deployments. Use a long random value.
SAPCLAW_API_KEYS=<replace-with-random-api-key>

# Codex-first read-only Thin Runtime. Keep disabled until explicitly testing it.
THIN_RUNTIME_ENABLED=false
THIN_RUNTIME_PAGE_SIZE=50
THIN_RUNTIME_MAX_BINDING_ROWS=5000
THIN_RUNTIME_VIEWER_ENABLED=true
THIN_RUNTIME_VIEWER_BASE_URL=http://127.0.0.1:8000
