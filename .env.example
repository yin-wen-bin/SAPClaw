# SAP connection
SAP_ODATA_BASE_URL=https://<your-sap-host>
SAP_USERNAME=<your-sap-username>
SAP_PASSWORD=<your-sap-password>
SAP_CLIENT=<sap-client>
SAP_VERIFY_SSL=true
SAP_AUTH_TYPE=basic
SAP_ODATA_TIMEOUT_MS=30000

# Runtime data and schema evidence
CASE_STORE_PATH=data/cases/cases.jsonl
LOCAL_INDEX_ROOT=data/index
API_SKILL_ROOT=data/api_skills
LOCAL_KG_ENABLED=true
LOCAL_KG_ROOT=data/knowledge_graph
LOCAL_KG_MAX_EVIDENCE=5

# Require X-API-Key for MCP and Runtime API operations when configured.
SAPCLAW_API_KEYS=<replace-with-random-api-key>

# SAPClaw Runtime behavior. The Runtime is always enabled in v2.
SAPCLAW_RUNTIME_PAGE_SIZE=50
SAPCLAW_RUNTIME_MAX_BINDING_ROWS=5000
SAPCLAW_RUNTIME_LIVE_SCHEMA_ENABLED=true
SAPCLAW_RUNTIME_LIVE_SCHEMA_TTL_SECONDS=300
SAPCLAW_RUNTIME_LIVE_SCHEMA_MAX_STALE_SECONDS=86400
SAPCLAW_RUNTIME_VIEWER_ENABLED=true
SAPCLAW_RUNTIME_VIEWER_BASE_URL=http://127.0.0.1:8000
